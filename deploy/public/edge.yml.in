http:
  routers:
    dsh-workstation-gateway:
      entryPoints: ["@ENTRYPOINT@"]
      rule: Host(@DOMAIN_RULE@) && (PathPrefix(@AUTH_RULE@) || PathPrefix(`/mgmt`) || Path(`/mgmt`))
      tls: @TLS@
      middlewares: [dsh-workstation-security]
      service: dsh-workstation-gateway
    dsh-workstation-browser:
      entryPoints: ["@ENTRYPOINT@"]
      rule: Host(@DOMAIN_RULE@) && PathPrefix(@BROWSER_RULE@) && !PathPrefix(@TOKENS_RULE@)
      tls: @TLS@
      middlewares: [dsh-workstation-security, dsh-workstation-signin, dsh-workstation-browser-frame]
      service: dsh-workstation-selkies
    dsh-workstation-dsh:
      entryPoints: ["@ENTRYPOINT@"]
      rule: Host(@DOMAIN_RULE@) && !PathPrefix(@AUTH_RULE@) && !Path(@AUTH_BASE@) && !PathPrefix(`/mgmt`) && !Path(`/mgmt`) && !PathPrefix(@BROWSER_RULE@) && !Path(@BROWSER_BASE@)
      tls: @TLS@
      middlewares: [dsh-workstation-security, dsh-workstation-signin]
      service: dsh-workstation-dsh
    dsh-workstation-browser-ws:
      entryPoints: ["@ENTRYPOINT@"]
      rule: Host(@DOMAIN_RULE@) && PathPrefix(@BROWSER_RULE@) && !PathPrefix(@TOKENS_RULE@) && HeaderRegexp(@UPGRADE_HEADER@, @UPGRADE_PATTERN@)
      priority: 200
      tls: @TLS@
      middlewares: [dsh-workstation-security, dsh-workstation-signin, dsh-workstation-browser-frame]
      service: dsh-workstation-gateway
    dsh-workstation-dsh-ws:
      entryPoints: ["@ENTRYPOINT@"]
      rule: Host(@DOMAIN_RULE@) && !PathPrefix(@AUTH_RULE@) && !Path(@AUTH_BASE@) && !PathPrefix(`/mgmt`) && !Path(`/mgmt`) && !PathPrefix(@BROWSER_RULE@) && !Path(@BROWSER_BASE@) && HeaderRegexp(@UPGRADE_HEADER@, @UPGRADE_PATTERN@)
      priority: 200
      tls: @TLS@
      middlewares: [dsh-workstation-security, dsh-workstation-signin]
      service: dsh-workstation-gateway
  middlewares:
    dsh-workstation-security:
      headers:
        stsSeconds: 31536000
        contentTypeNosniff: true
        referrerPolicy: same-origin
        customRequestHeaders:
          X-Forwarded-User: ""
          Remote-User: ""
          X-Workstation-User: ""
    dsh-workstation-signin:
      forwardAuth:
        address: http://dsh-workstation-gateway-edge:8081/verify
        trustForwardHeader: false
        preserveLocationHeader: true
        authRequestHeaders: [Cookie, Accept, Sec-Fetch-Mode, Sec-Fetch-Dest, Upgrade]
        maxResponseBodySize: 4096
    dsh-workstation-browser-frame:
      headers:
        customRequestHeaders:
          Selkies-Authorization: ""
        customResponseHeaders:
          Content-Security-Policy: "frame-ancestors 'self'"
          X-Frame-Options: SAMEORIGIN
  serversTransports:
    dsh-workstation-dsh-tls:
      serverName: runtime
      rootCAs:
        - |
@RUNTIME_CA@
  services:
    dsh-workstation-gateway:
      loadBalancer:
        servers:
          - url: http://dsh-workstation-gateway-edge:8080
    dsh-workstation-dsh:
      loadBalancer:
        serversTransport: dsh-workstation-dsh-tls
        servers:
          - url: https://runtime:3080
    dsh-workstation-selkies:
      loadBalancer:
        servers:
          - url: http://browser:3000
