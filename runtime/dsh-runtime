#!/usr/bin/env bash
set -euo pipefail
umask 077

root="$DSH_HOME/runtime"
selection="$root/selection"
audit="$root/audit.jsonl"
# Locate the helper modules. The image installs them at
# /usr/local/lib/dsh-runtime and the binary at /usr/local/bin, so
# ../lib/dsh-runtime resolves there; a checkout keeps them side by side.
self_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
for candidate in "${DSH_RUNTIME_LIB:-}" "$self_dir" "$self_dir/../lib/dsh-runtime" /usr/local/lib/dsh-runtime; do
  [[ -n $candidate && -f $candidate/compat.mjs && -f $candidate/state.mjs ]] || continue
  lib="$(cd -- "$candidate" && pwd)"
  break
done
[[ -n ${lib:-} ]] || { printf 'dsh-runtime: cannot locate compat.mjs and state.mjs\n' >&2; exit 1; }
web="$lib/web.mjs"
compat="$lib/compat.mjs"
state="$lib/state.mjs"
# Backups live outside DSH_HOME so a data restore cannot overwrite them.
backup_dir="${DSH_BACKUP_DIR:-/backup}"
mkdir -p "$root/versions"

die() { printf 'dsh-runtime: %s\n' "$*" >&2; exit 1; }
exact() { [[ $1 =~ ^[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z]+([.-][0-9A-Za-z]+)*)?$ ]]; }
bin() { printf '%s/versions/%s/node_modules/.bin/dsh\n' "$root" "$1"; }
chosen() {
  active= previous=
  if [[ -f $selection ]]; then
    read -r active previous < "$selection"
    exact "$active" && { [[ -z $previous ]] || exact "$previous"; } || die 'invalid stored selection'
  fi
}
lock() {
  exec 9>"$root/.lock"
  flock -n -x 9 || die 'runtime is serving or being modified; stop it before maintenance'
  chosen
}
# A backup only reads. It still excludes an upgrade (which holds the exclusive
# lock), so it cannot capture a half-switched state, but it does not exclude the
# serving process — which is the normal case, since the management page is used
# while DSH is up.
lock_shared() {
  exec 9>"$root/.lock"
  flock -n -s 9 || die 'an upgrade or restore is in progress; retry when it finishes'
  chosen
}
record() { node "$state" record --append "$audit" --json-file "$1" > /dev/null; }
# Build a structured audit record without passing it through argv, which a
# large Profile fingerprint would exceed.
entry() {
  local file
  file="$(mktemp "$root/.audit.XXXXXXXX.json")"
  node -e "$1" -- "$file" "${@:2}"
  printf '%s' "$file"
}
stamp() { date -u +%Y-%m-%dT%H:%M:%SZ; }
random() { od -An -N6 -tx1 /dev/urandom | tr -d ' \n'; }
runtime_image() { printf '%s' "${WORKSTATION_RUNTIME_IMAGE:-unpinned}"; }
pnpm_version() { pnpm --version 2>/dev/null || printf 'unknown'; }

install_version() (
  version=$1
  exact "$version" || die 'provide an exact npm version'
  target="$root/versions/$version"
  if [[ -e $target ]]; then
    [[ -x $(bin "$version") ]] || die 'existing version directory is incomplete'
    return
  fi
  stage="$(mktemp -d "$root/versions/.install.XXXXXXXX")"
  trap 'rm -rf -- "$stage"' EXIT
  printf '{"name":"dsh-workstation-runtime","private":true}\n' > "$stage/package.json"
  printf 'storeDir: %s\nengineStrict: true\nignoreScripts: true\n' "$DSH_HOME/pnpm/store" > "$stage/pnpm-workspace.yaml"
  pnpm --dir "$stage" add --registry https://registry.npmjs.org --save-exact --ignore-scripts \
    --ignore-workspace-root-check "@deepseek-ai/dsh@$version"
  [[ $("$stage/node_modules/.bin/dsh" --version) == "$version" ]] || die 'installed CLI version does not match'
  mv -T -- "$stage" "$target"
  printf 'Installed DSH %s\n' "$version"
)
# Snapshot DSH_HOME data plus a manifest that identifies the exact Runtime
# image, DSH selection and Profile dependency set it belongs to.
snapshot() (
  mkdir -p "$backup_dir"
  id="$(date -u +%Y%m%dT%H%M%SZ).$(random)"
  output="$backup_dir/dsh-home.$id.tgz"
  manifest="$backup_dir/dsh-home.$id.json"
  [[ ! -e $output ]] || die "backup $id already exists"
  trap 'rm -f -- "$output" "$manifest"' EXIT
  # Installed DSH versions and the pnpm content-addressable store are both
  # reinstallable from the registry, so they stay out of the archive. Measured
  # on real installs the store alone was 869 MB, which turned a small state
  # backup into a 223 MB one. Profile `node_modules` stays in, because those
  # are the files the Profile actually runs. The selection pointer is recorded
  # in the manifest instead, which is what lets a restore return a matched set.
  tar -czf "$output" --exclude='./runtime' --exclude='./pnpm' -C "$DSH_HOME" .
  node "$state" manifest --dsh-home "$DSH_HOME" --archive "$output" --output "$manifest" \
    --backup "$id" --runtime-image "$(runtime_image)" --pnpm "$(pnpm_version)" \
    --manager "$self_dir/dsh-runtime" --web "$web" >/dev/null
  chmod 0444 "$output" "$manifest"
  trap - EXIT
  printf 'State backup: %s\n' "$output"
  printf 'Manifest: %s (active version: %s)\n' "$manifest" "${active:-none}"
  printf 'Backup id: %s\n' "$id"
)
probe() (
  version=$1
  local candidate
  candidate="$(bin "$version")"
  [[ -x $candidate ]] || die 'version is not installed'
  scratch="$(mktemp -d "$root/.probe.XXXXXXXX")" || die 'could not create a readiness directory'
  trap 'rm -rf -- "$scratch"' EXIT
  # Keep candidate startup and Profile initialization away from live state.
  # The pnpm store stays in this copy on purpose: DSH may reinstall a Profile
  # during activation, and a probe that depends on the registry is less reliable
  # than a slower one. The cost is real (the store measured 869 MB), so the
  # readiness check is a maintenance operation, not something on the serve path
  # of an already-selected version.
  tar -cf - --exclude='./runtime' -C "$DSH_HOME" . | tar -xf - -C "$scratch" ||
    die 'could not copy Profile state for readiness'
  DSH_HOME="$scratch" npm_config_store_dir="$scratch/pnpm/store" node "$web" probe "$candidate"
)
# Node/DSH startup, Profile and Bundle compatibility, lockfile presence and
# unapproved lifecycle scripts. A failure here leaves live state untouched.
compat_gate() {
  local version=$1 report status
  report="$(mktemp)" || die 'could not create a compatibility report'
  # Approvals live in DSH_HOME so they travel with the data they describe and
  # apply to every later transaction, including a rollback. An extra file can
  # be supplied per command, but it never replaces the recorded set.
  local approvals
  approvals="$(mktemp)" || die 'could not stage script approvals'
  {
    [[ -f $DSH_HOME/approved-scripts.txt ]] && cat -- "$DSH_HOME/approved-scripts.txt"
    [[ -n ${DSH_APPROVED_SCRIPTS:-} && -f $DSH_APPROVED_SCRIPTS ]] && cat -- "$DSH_APPROVED_SCRIPTS"
  } > "$approvals" || true
  if node "$compat" check --dsh-home "$DSH_HOME" --candidate "$version" --approve-scripts "$approvals" > "$report"; then
    status=pass
  else
    status=fail
  fi
  node -e '
    const report = JSON.parse(require("node:fs").readFileSync(process.argv[1], "utf8"))
    console.log(`Node ${report.node.version} (${report.node.engine ?? "no range"}): ${report.node.verdict}`)
    for (const profile of report.profiles) {
      console.log(`Profile ${profile.name}: ${profile.bundles.length} bundles, lockfile ${profile.lockfile ? "present" : "missing"}`)
      for (const bundle of profile.bundles) console.log(`  ${bundle.package} ${bundle.installed ?? "not installed"}: ${bundle.verdict ?? "skipped"}${bundle.engines ? ` (dsh ${bundle.engines})` : ""}`)
    }
    console.log(`Profile dependencies: ${report.dependencies.profile.scanned} scanned, ${report.dependencies.profile.total} with lifecycle scripts, ${report.dependencies.profile.pending} unapproved`)
    console.log(`Upstream dependencies: ${report.dependencies.upstream.scanned} scanned, ${report.dependencies.upstream.withScripts} with lifecycle scripts (not a switch blocker)`)
  ' "$report"
  if [[ $status != pass ]]; then
    node -e 'for (const failure of JSON.parse(require("node:fs").readFileSync(process.argv[1], "utf8")).failures) console.error(`  blocked: ${failure}`)' "$report" >&2
  fi
  cp -- "$report" "$root/.last-compat.json" 2>/dev/null || true
  rm -f -- "$report" "$approvals"
  [[ $status == pass ]] || die "candidate $version failed the compatibility gate; live state is unchanged"
}
# Approve one exact installed package version, so a later upgrade to a different
# version needs its own approval. This is the documented narrow approval step.
approve_script() {
  local key=$1 file="$DSH_HOME/approved-scripts.txt"
  # Anchor both ends: an approval must be exactly one package@version, so a
  # trailing suffix or a second @ cannot be smuggled in.
  [[ $key =~ ^(@[^/@]+/)?[^@/]+@[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z]+([.-][0-9A-Za-z]+)*)?$ ]] ||
    die 'approve only an exact package@version, for example native-thing@2.0.0'
  touch "$file"
  chmod 0600 "$file"
  if ! grep -qxF -- "$key" "$file"; then
    printf '%s\n' "$key" >> "$file"
  fi
  printf 'Approved lifecycle scripts for %s\n' "$key"
  record "$(entry '
    const [out, key, at] = process.argv.slice(1)
    require("node:fs").writeFileSync(out, JSON.stringify({ phase: "script-approved", at, package: key }))
  ' "$key" "$(stamp)")"
}
select_version() {
  local version=$1 next
  exact "$version" || die 'provide an exact npm version'
  [[ $version != "$active" ]] || return 0
  compat_gate "$version"
  probe "$version" || die 'candidate failed readiness; stored selection is unchanged'
  if [[ -n $active ]]; then snapshot; fi
  next="$(mktemp "$root/.select.XXXXXXXX")"
  printf '%s %s\n' "$version" "$active" > "$next"
  mv -Tf -- "$next" "$selection"
  active=$version
  printf 'Selected DSH %s\n' "$active"
}

case "${1:-}" in
  serve)
    lock
    if [[ -z $active ]]; then
      version=${DSH_INITIAL_VERSION:?set DSH_INITIAL_VERSION to an exact version}
      install_version "$version"
      select_version "$version"
    fi
    if [[ ${WORKSTATION_BROWSER_MCP:-} == 1 ]]; then
      bundle="$DSH_HOME/profiles/web/.workstation-browser-0.1.0"
      if [[ ! -f $bundle ]]; then
        [[ $active == 0.2.2-rc.1 ]] || die 'browser bundle requires the verified DSH 0.2.2-rc.1'
        if [[ -d $DSH_HOME/profiles/web ]]; then snapshot; fi
        "$(bin "$active")" plugin --profile web add --save-exact --ignore-scripts --ignore-workspace-root-check link:/opt/workstation-browser
        touch "$bundle"
      fi
    fi
    # Startup work is done; release the pointer lock so maintenance can run. The
    # listener re-takes it, exclusively, for a change that rewrites DSH_HOME.
    # Holding it for the process lifetime made every maintenance action
    # impossible while DSH ran, including a backup, which only reads.
    flock -u 9 2>/dev/null || true
    # The listener must outlive the Web supervisor, so this shell stays and waits
    # instead of `exec`-ing: `exec` would replace it and orphan the listener. The
    # supervisor runs as a child, its stop signal is forwarded, and its exit status
    # becomes the container's.
    maintenance_pid=
    if [[ -f /usr/local/lib/dsh-runtime/maintenance.mjs ]]; then
      node /usr/local/lib/dsh-runtime/maintenance.mjs &
      maintenance_pid=$!
    fi
    node "$web" serve "$(bin "$active")" &
    web_pid=$!
    trap 'kill "$web_pid" ${maintenance_pid:+"$maintenance_pid"} 2>/dev/null || true' TERM INT
    wait "$web_pid"
    status=$?
    if [[ -n $maintenance_pid ]]; then kill "$maintenance_pid" 2>/dev/null || true; fi
    exit "$status"
    ;;
  install) lock; install_version "${2:-}" ;;
  upgrade)
    lock
    from=${active:-none}
    want=${2:-}
    exact "$want" || die 'usage: dsh-runtime upgrade VERSION'
    [[ $want != "$from" ]] || die "DSH $want is already selected"
    printf 'Upgrade %s -> %s\n' "$from" "$want"
    install_version "$want"
    compat_gate "$want"
    probe "$want" || die 'candidate failed readiness; live state is unchanged'
    started="$(stamp)"
    before="$(mktemp "$root/.before.XXXXXXXX.json")"
    node "$state" fingerprint --dsh-home "$DSH_HOME" > "$before"
    record "$(entry '
      const [out, started, from, to, before, image] = process.argv.slice(1)
      require("node:fs").writeFileSync(out, JSON.stringify({ phase: "start", at: started, from, to,
        runtimeImage: image, before: JSON.parse(require("node:fs").readFileSync(before, "utf8")) }))
    ' "$started" "$from" "$want" "$before" "$(runtime_image)")"
    backup_line="$(snapshot)"
    backup_id="$(printf '%s\n' "$backup_line" | sed -n 's/^Backup id: //p')"
    backup_path="$(printf '%s\n' "$backup_line" | sed -n 's/^State backup: //p')"
    printf '%s\n' "$backup_line"
    [[ -n $backup_id && -f $backup_path ]] || die 'backup did not produce a usable archive; live state is unchanged'
    next="$(mktemp "$root/.select.XXXXXXXX")"
    printf '%s %s\n' "$want" "$from" > "$next"
    mv -Tf -- "$next" "$selection"
    active=$want
    record "$(entry '
      const [out, at, from, to, id, archive, before] = process.argv.slice(1)
      require("node:fs").writeFileSync(out, JSON.stringify({ phase: "switched", at, from, to, backup: id,
        archive, before: JSON.parse(require("node:fs").readFileSync(before, "utf8")) }))
    ' "$(stamp)" "$from" "$want" "$backup_id" "$backup_path" "$before")"
    rm -f -- "$before"
    cat <<EOF
Selected DSH $active
Restart the Runtime, then run 'dsh-runtime verify' to record whether the new
version migrated Profile state. Pointer rollback alone does not undo data:
if it migrated, restore with 'dsh-runtime restore $backup_id'.
EOF
    ;;
  verify)
    lock
    # Compare live state against the `start` record of the most recent upgrade
    # transaction, which is the only baseline that always exists, and pair it
    # with the `switched` record that carries the matched backup id.
    transaction="$(node -e '
      const fs = require("node:fs")
      let lines = []
      try { lines = fs.readFileSync(process.argv[1], "utf8").trim().split("\n").filter(Boolean) } catch {}
      const records = lines.map(line => JSON.parse(line))
      let start = null
      let switched = null
      for (const record of records) {
        if (record.phase === "start") { start = record; switched = null }
        if (record.phase === "switched" && start) switched = record
      }
      if (start) console.log(JSON.stringify({ ...start, backup: switched?.backup ?? null, archive: switched?.archive ?? null }))
    ' "$audit")"
    [[ -n $transaction ]] || die 'no upgrade transaction to verify'
    pair="$(mktemp "$root/.pair.XXXXXXXX.json")"
    printf '%s' "$transaction" > "$pair"
    now="$(mktemp "$root/.now.XXXXXXXX.json")"
    node "$state" fingerprint --dsh-home "$DSH_HOME" > "$now"
    prior="$(mktemp "$root/.prior.XXXXXXXX.json")"
    node -e 'console.log(JSON.stringify(JSON.parse(require("node:fs").readFileSync(process.argv[1], "utf8")).before))' "$pair" > "$prior"
    diff_status=0
    node "$state" diff --before "$prior" --after "$now" || diff_status=$?
    case $diff_status in
      0) changes=no ;;
      10) changes=yes ;;
      *) rm -f -- "$pair" "$now" "$prior"; die 'could not compare Profile state; nothing was recorded' ;;
    esac
    node -e '
      const entry = JSON.parse(require("node:fs").readFileSync(process.argv[1], "utf8"))
      console.log(`Active ${entry.to} (from ${entry.from}); Profile state ${process.argv[2] === "yes" ? "MIGRATED" : "unchanged"}`)
    ' "$pair" "$changes"
    record "$(entry '
      const [out, pair, now, changes, at] = process.argv.slice(1)
      const { before, ...transaction } = JSON.parse(require("node:fs").readFileSync(pair, "utf8"))
      const after = JSON.parse(require("node:fs").readFileSync(now, "utf8"))
      require("node:fs").writeFileSync(out, JSON.stringify({ phase: "verified", at,
        from: transaction.from, to: transaction.to, backup: transaction.backup,
        migrated: changes === "yes", after }))
    ' "$pair" "$now" "$changes" "$(stamp)")"
    backup_id="$(node -e 'console.log(JSON.parse(require("node:fs").readFileSync(process.argv[1], "utf8")).backup ?? "")' "$pair")"
    rm -f -- "$pair" "$now" "$prior"
    if [[ $changes == yes ]]; then
      printf 'This transaction changed persistent Profile state, so a pointer rollback would leave the new data behind.\n'
      if [[ -n $backup_id ]]; then
        printf 'Restore the matching backup instead:\n  dsh-runtime restore %s\n' "$backup_id"
      else
        printf 'No matched backup was recorded for this transaction; do not roll back the pointer.\n'
      fi
    elif [[ -n $backup_id ]]; then
      printf 'Profile state is unchanged, so pointer rollback is sufficient. The matched backup is %s.\n' "$backup_id"
    fi
    ;;
  restore)
    lock
    id=${2:-}
    [[ -n $id ]] || die 'usage: dsh-runtime restore BACKUP_ID'
    archive="$backup_dir/dsh-home.$id.tgz"
    [[ -f $archive ]] || die "no backup archive for $id in $backup_dir"
    manifest="${archive%.tgz}.json"
    [[ -f $manifest ]] || die "backup $id has no manifest; refusing an unverifiable restore"
    node "$state" verify --archive "$archive" --manifest "$manifest" >/dev/null || die 'backup failed verification; live state is unchanged'
    # Report a Runtime-image difference rather than refusing: restoring data
    # from an older image is a supported recovery path, but the operator must
    # see it. Ownership is checked because tar records numeric ids and a
    # mismatched restore would leave the tree unreadable.
    node -e '
      const [manifest, image] = process.argv.slice(1)
      const m = JSON.parse(require("node:fs").readFileSync(manifest, "utf8"))
      const uid = typeof process.getuid === "function" ? process.getuid() : null
      if (m.runtime.uid !== null && m.runtime.uid !== undefined && uid !== null && m.runtime.uid !== uid) {
        console.error(`dsh-runtime: backup was written as uid ${m.runtime.uid} but this process is uid ${uid}; restored files would not be readable`)
        process.exitCode = 1
      } else if (m.runtime.image && m.runtime.image !== "unpinned" && image !== "unpinned" && m.runtime.image !== image) {
        console.error(`dsh-runtime: warning: backup belongs to Runtime image ${m.runtime.image}, this is ${image}`)
      }
    ' "$manifest" "$(runtime_image)" || die 'backup ownership does not match this Runtime; refusing a restore that would be unreadable'
    restore_to="$(node -e 'const m = JSON.parse(require("node:fs").readFileSync(process.argv[1], "utf8")); console.log(m.dsh.active ?? "")' "$manifest")"
    [[ -n $restore_to ]] || die 'manifest records no DSH version'
    [[ -x $(bin "$restore_to") ]] || die "backup belongs to DSH $restore_to which is not installed; install it first so the restored data matches its Runtime"
    stage="$(mktemp -d "$DSH_HOME/.restore.XXXXXXXX")" || die 'could not create a restore staging directory'
    hold="$(mktemp -d "$DSH_HOME/.restore-old.XXXXXXXX")" || die 'could not create a restore hold directory'
    trap 'rm -rf -- "$stage" "$hold"' EXIT
    tar -xzf "$archive" -C "$stage"
    # Swap every restored top-level entry, but never the trees the archive
    # deliberately excludes: installed DSH versions and the pnpm store are
    # reinstallable, and the audit log lives under runtime. The staging and hold
    # directories are excluded so the swap cannot move itself. If a move fails
    # part way, the held entries are moved back.
    keep=(runtime pnpm)
    should_keep() {
      local name=$1 candidate
      for candidate in "${keep[@]}" "${stage##*/}" "${hold##*/}"; do
        [[ $name == "$candidate" ]] && return 0
      done
      return 1
    }
    current=()
    while IFS= read -r -d '' entry; do
      name=${entry##*/}
      should_keep "$name" || current+=("$name")
    done < <(find "$DSH_HOME" -mindepth 1 -maxdepth 1 -print0)
    incoming=()
    while IFS= read -r -d '' entry; do incoming+=("${entry##*/}"); done < <(find "$stage" -mindepth 1 -maxdepth 1 -print0)
    rollback_restore() {
      for name in "${incoming[@]}"; do rm -rf -- "${DSH_HOME:?}/$name"; done
      for name in "${hold}"/*; do [[ -e $name ]] || continue; mv -- "$name" "$DSH_HOME/"; done
      printf 'dsh-runtime: restore failed; the previous DSH_HOME data was put back\n' >&2
      exit 1
    }
    trap rollback_restore ERR
    for name in "${current[@]}"; do mv -- "$DSH_HOME/$name" "$hold/"; done
    for name in "${incoming[@]}"; do mv -- "$stage/$name" "$DSH_HOME/$name"; done
    trap - ERR
    rm -rf -- "$stage" "$hold"
    trap - EXIT
    next="$(mktemp "$root/.select.XXXXXXXX")"
    printf '%s %s\n' "$restore_to" "" > "$next"
    mv -Tf -- "$next" "$selection"
    active=$restore_to previous=
    record "$(entry '
      const [out, at, id, version, image] = process.argv.slice(1)
      require("node:fs").writeFileSync(out, JSON.stringify({ phase: "restored", at, backup: id,
        to: version, runtimeImage: image }))
    ' "$(stamp)" "$id" "$restore_to" "$(runtime_image)")"
    printf 'Restored DSH_HOME data from %s and selected DSH %s\n' "$id" "$restore_to"
    printf 'Start the Runtime and confirm readiness before relying on this state.\n'
    ;;
  backups)
    for manifest in "$backup_dir"/dsh-home.*.json; do
      [[ -f $manifest ]] || continue
      node -e '
        const manifest = JSON.parse(require("node:fs").readFileSync(process.argv[1], "utf8"))
        const image = manifest.runtime?.image ?? "unknown"
        console.log(`${manifest.backup}  dsh ${manifest.dsh.active}  ${manifest.createdAt}  ${manifest.archiveSize} bytes  ${image}`)
      ' "$manifest"
    done
    ;;
  check)
    # Verify a backup without restoring it, so an operator can prove an archive
    # is usable before they depend on it.
    id=${2:-}
    [[ -n $id ]] || die 'usage: dsh-runtime check BACKUP_ID'
    archive="$backup_dir/dsh-home.$id.tgz"
    [[ -f $archive ]] || die "no backup archive for $id in $backup_dir"
    manifest="${archive%.tgz}.json"
    [[ -f $manifest ]] || die "backup $id has no manifest; refusing an unverifiable backup"
    node "$state" verify --archive "$archive" --manifest "$manifest"
    node -e '
      const m = JSON.parse(require("node:fs").readFileSync(process.argv[1], "utf8"))
      const here = process.argv[2]
      if (m.runtime.image && m.runtime.image !== here) {
        console.log(`warning: backup belongs to Runtime image ${m.runtime.image}, this is ${here}`)
      }
      console.log(`This backup restores DSH ${m.dsh.active} with ${m.state.profiles.length} Profile(s).`)
    ' "$manifest" "$(runtime_image)"
    ;;
  select) lock; select_version "${2:-}" ;;
  approve)
    lock
    approve_script "${2:-}"
    printf 'Re-run the failed upgrade. The approval applies to every later transaction.\n'
    ;;
  rollback)
    lock
    [[ -n $previous ]] || die 'no previous version'
    # Pointer rollback only. Printed explicitly so it is never mistaken for a
    # data rollback.
    printf 'Pointer rollback to %s. This changes only the selected executable.\n' "$previous"
    printf 'If DSH %s migrated Profile state, restore the matching backup instead.\n' "$active"
    from=$active to=$previous
    select_version "$to"
    record "$(entry '
      const [out, at, from, to] = process.argv.slice(1)
      require("node:fs").writeFileSync(out, JSON.stringify({ phase: "pointer-rollback", at, from, to }))
    ' "$(stamp)" "$from" "$to")"
    ;;
  backup) lock_shared; snapshot ;;
  audit)
    [[ -f $audit ]] || { printf 'No upgrade records.\n'; exit 0; }
    node -e 'for (const line of require("node:fs").readFileSync(process.argv[1], "utf8").trim().split("\n").filter(Boolean)) { const r = JSON.parse(line); console.log([r.at, r.phase, r.from ? `${r.from} -> ${r.to}` : "", r.backup ?? "", r.migrated === undefined ? "" : `migrated=${r.migrated}`].filter(Boolean).join("  ")) }' "$audit"
    ;;
  compat)
    lock
    [[ -n ${2:-$active} ]] || die 'usage: dsh-runtime compat VERSION (no version is selected)'
    compat_gate "${2:-$active}"
    printf 'Compatibility gate passed for %s\n' "${2:-$active}"
    ;;
  inspect)
    # Report what a backup would contain, so an operator can judge size and
    # which bundles pin the DSH version before attempting an upgrade.
    lock
    node "$compat" inventory --dsh-home "$DSH_HOME" | node -e '
      const report = JSON.parse(require("node:fs").readFileSync(0, "utf8"))
      console.log(`Profile data: ${report.size.files} files, ${report.size.bytes} bytes`)
      for (const profile of report.profiles) {
        console.log(`${profile.name}: ${profile.bundles.length} bundles, lockfile ${profile.lockfile ? "present" : "absent"}`)
        for (const bundle of profile.bundles) console.log(`  ${bundle.package} ${bundle.installed ?? "not installed"}${bundle.engines ? ` (dsh ${bundle.engines})` : ""}`)
      }
    '
    ;;
  versions) exec pnpm view --registry https://registry.npmjs.org @deepseek-ai/dsh versions --json ;;
  components)
    # What this image and this home actually contain, reported rather than
    # assumed: the management page must show the Node the container runs.
    printf 'node %s\n' "$(node --version 2>/dev/null || echo unknown)"
    printf 'pnpm %s\n' "$(pnpm --version 2>/dev/null || echo unknown)"
    printf 'git %s\n' "$(git --version 2>/dev/null | awk '{print $3}' || echo unknown)"
    printf 'python %s\n' "$(python3 --version 2>/dev/null | awk '{print $2}' || echo unknown)"
    printf 'os %s\n' "$(. /etc/os-release 2>/dev/null && echo "$PRETTY_NAME" || echo unknown)"
    printf 'arch %s\n' "$(uname -m)"
    printf 'runtime-image %s\n' "${WORKSTATION_RUNTIME_IMAGE:-unknown}"
    if [[ -n ${active:-} ]]; then printf 'dsh-active %s\n' "$active"; fi
    ;;
  status)
    chosen
    printf 'Active: %s\nPrevious: %s\n' "${active:-none}" "${previous:-none}"
    for manifest in "$root"/versions/*/package.json; do
      [[ -f $manifest ]] || continue
      version=${manifest%/package.json}
      printf 'Installed: %s\n' "${version##*/}"
    done
    ;;
  launch-url)
    cat /run/dsh-runtime/launch-url
    ;;
  health)
    exec node "$web" health
    ;;
  *) die 'usage: dsh-runtime {serve|install VERSION|upgrade VERSION|select VERSION|rollback|verify|restore BACKUP_ID|check BACKUP_ID|backups|backup|approve PACKAGE@VERSION|audit|compat|inspect|status|components|versions|health|launch-url}' ;;
esac
